# Copiar a notifications/.env (no commitear). Usado por docker compose en esta carpeta
# y referenciado desde la raíz vía env_file si lo agregás al compose raíz.

# Evolution API
EVOLUTION_API_KEY=CHANGE_ME_LONG_RANDOM
EVOLUTION_PG_PASSWORD=CHANGE_ME_PG
# URL pública que WhatsApp/Evolution usan para QR y webhooks (mismo host que nginx)
EVOLUTION_PUBLIC_URL=http://127.0.0.1:8090

# n8n
N8N_PG_PASSWORD=CHANGE_ME_N8N_PG
N8N_AUTH_USER=admin
N8N_AUTH_PASS=CHANGE_ME_N8N_UI
# Base URL pública de n8n (para webhooks generados en UI)
N8N_PUBLIC_URL=http://127.0.0.1:5678/

# Zona horaria para reglas de silencio en el dashboard (misma que n8n GENERIC_TIMEZONE)
WHATSAPP_TZ=America/Asuncion
