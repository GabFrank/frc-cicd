# Ejemplo unificado para `docker compose up` desde la raíz (frc-cicd/).
# Copiar a .env o usar: docker compose --env-file notifications/.env --env-file dashboard/.env up -d
#
# --- Dashboard (también en dashboard/.env.example) ---
GITHUB_PAT=
SESSION_SECRET=
AUTH_USER=admin
AUTH_PASS=
CENTRAL_BASE_URL=http://host.docker.internal

# --- Notificaciones / Evolution + n8n (también en notifications/.env.example) ---
EVOLUTION_API_KEY=
EVOLUTION_PG_PASSWORD=
EVOLUTION_PUBLIC_URL=http://127.0.0.1:8090
N8N_PG_PASSWORD=
N8N_AUTH_USER=admin
N8N_AUTH_PASS=
N8N_PUBLIC_URL=http://127.0.0.1:5678/
WHATSAPP_TZ=America/Asuncion
