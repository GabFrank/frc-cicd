# Archivo único para el host on-prem. Copiar a `.env` (ignorado por git):
#   cp .env.example .env   # y editar
#
# Docker compose carga `.env` automáticamente si está en el mismo directorio.
#
# Arranque on-prem:
#   docker compose pull           # baja imagen dashboard desde GHCR (+ Evolution/n8n/postgres/redis)
#   docker compose up -d          # migrate corre una vez, luego dashboard + jobs + Evolution + n8n
#
# Para dev local (build desde source):
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build

# =============== Imagen del dashboard ===============
# Default: ghcr.io/gabfrank/frc-dashboard:latest (pública, sin login)
# Pin a un sha específico si querés estabilidad: ghcr.io/gabfrank/frc-dashboard:sha-abcd123
# DASHBOARD_IMAGE=ghcr.io/gabfrank/frc-dashboard:latest

# =============== Secrets obligatorios ===============
GITHUB_PAT=ghp_xxx                                   # PAT con scope `repo` para leer los 4 repos
SESSION_SECRET=                                      # ≥32 chars aleatorios — `openssl rand -base64 48`
AUTH_USER=admin
AUTH_PASS=                                           # contraseña del admin único
# Sin TLS público (deploy on-prem por ZeroTier) → cookie NO puede ser secure.
# Si ponés nginx + certbot delante, dejar en true (o comentar — default=true si NODE_ENV=production).
SESSION_COOKIE_SECURE=false

# =============== Conexión al central ===============
# Mismo droplet: http://host.docker.internal
# VM separada por ZeroTier: http://172.25.1.200
CENTRAL_BASE_URL=http://host.docker.internal

# =============== Intervalos de jobs ===============
SYNC_GITHUB_INTERVAL_MS=300000
SYNC_HEALTH_INTERVAL_MS=60000
SYNC_REPLICATION_INTERVAL_MS=120000
EVALUATE_ALERTS_INTERVAL_MS=60000

# =============== Notificaciones WhatsApp ===============
EVOLUTION_API_KEY=                                   # `openssl rand -hex 24`
EVOLUTION_PG_PASSWORD=                               # `openssl rand -hex 16`
EVOLUTION_PUBLIC_URL=http://127.0.0.1:8090
EVOLUTION_INSTANCE_NAME=frc-alertas
# URL pública usada en el WhatsApp ("PANEL: ..."). ZeroTier o localhost.
DASHBOARD_PUBLIC_URL=http://172.25.1.200:3000
WHATSAPP_TZ=America/Asuncion
NOTIFY_ALERTS_ENABLED=true

# =============== Thresholds host_unreachable ===============
# HOST_UNREACHABLE_WARN_AFTER_HOURS=12
# HOST_UNREACHABLE_CRITICAL_AFTER_HOURS=24

# =============== n8n ===============
N8N_PG_PASSWORD=                                     # `openssl rand -hex 16`
N8N_AUTH_USER=admin
N8N_AUTH_PASS=                                       # `openssl rand -hex 12`
N8N_PUBLIC_URL=http://127.0.0.1:5678/
# Webhook opcional para routing custom. Vacío = no se usa.
# N8N_ALERT_WEBHOOK_URL=
