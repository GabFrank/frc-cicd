# GitHub API — PAT con scope `repo` (reutiliza el existente en frc-cicd)
GITHUB_PAT=ghp_replace_me

# Ruta del archivo SQLite. En Docker: /data/dash.db
DB_PATH=./dev.db

# Auth iron-session — mínimo 32 chars para SESSION_SECRET
SESSION_SECRET=replace_me_with_32_or_more_random_chars
AUTH_USER=admin
AUTH_PASS=replace_me

# Intervalos en milisegundos (dev puede ser más corto)
SYNC_GITHUB_INTERVAL_MS=300000
SYNC_HEALTH_INTERVAL_MS=60000
EVALUATE_ALERTS_INTERVAL_MS=60000

# Base URL de las instancias del central (en droplet: http://localhost)
CENTRAL_BASE_URL=http://localhost

# Mock de GitHub para desarrollo offline (true/false)
GITHUB_MOCK=false

# PostgreSQL del droplet central (localhost). Si está vacío, sync-replication no corre.
PG_HOST=localhost
PG_USER=franco
PG_PASSWORD=
# Lista puerto:label[:db1,db2] separada por coma. Ejemplo:
#   5551:central-prod:alpha,farmacia,bodega,5552:central-beta:beta
PG_CLUSTERS=
SYNC_REPLICATION_INTERVAL_MS=120000

# F8 opcional — webhook de n8n para notificación de alertas
# N8N_ALERT_WEBHOOK_URL=
