# /etc/nginx/sites-available/frc-dashboard.conf
# Activar: ln -s ../sites-available/frc-dashboard.conf /etc/nginx/sites-enabled/
# TLS: certbot --nginx -d dashboard.frc.tld

server {
    listen 80;
    server_name dashboard.frc.tld;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name dashboard.frc.tld;

    # ssl_certificate /etc/letsencrypt/live/dashboard.frc.tld/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/dashboard.frc.tld/privkey.pem;

    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
